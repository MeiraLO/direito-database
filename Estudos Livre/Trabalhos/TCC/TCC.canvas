		},
		{"id":"0c402f620ae66777","type":"text","text":"Moralidade","x":-4682,"y":60,"width":250,"height":60,"color":"#642617"},
		{
			"id":"d663f444834aeb43",
			"type":"text",
			"text":"Ownership of the body\nperspectiva material e espiritual\ndiferenças entre o que se entende médicamente e o que se entende de si",
			"styleAttributes":{},
			"x":-5280,
			"y":270,
			"width":260,
			"height":208,
			"color":"#932525"
		},
		{
			"id":"5b915cce895a8d5c",
			"type":"text",
			"text":"**Objetivo**\nDesenvolver um artigo sobre neurodireitos e bioética aplicada. Não como um mero trabalho explicativo, mas uma investigação sobre a incorporação dos neurodireitos ao novo código civil, a sua justificação ética e os limites deste proteção, observando a preservação da indentidade, a autonomia e a dignidade humana.",
			"styleAttributes":{},
			"x":-3915,
			"y":-665,
			"width":324,
			"height":295,
			"color":"4"
		},
		{"id":"7522350f89d0910f","type":"text","text":"Neurodireitos","x":-3147,"y":-400,"width":155,"height":60,"color":"#5c11a7"},
