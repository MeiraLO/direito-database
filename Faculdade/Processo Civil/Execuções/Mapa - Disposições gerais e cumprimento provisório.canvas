		{"id":"comp2","type":"text","text":"P.u.: domicílio do executado · bens · local do fazer → direito potestativo (D-B-L) · só II e III","x":980,"y":-610,"width":400,"height":140,"color":"#2E86C1"},
		{"id":"comp3","type":"text","text":"Pode após iniciado (REsp 1.776.382) · juiz não muda de ofício","x":980,"y":-450,"width":400,"height":140,"color":"#2E86C1"},
